<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <webSocket enabled="true" />

    <httpProtocol>
      <customHeaders>
        <remove name="Access-Control-Allow-Origin" />
        <remove name="Access-Control-Allow-Headers" />
        <remove name="Access-Control-Allow-Methods" />
        <remove name="Access-Control-Allow-Credentials" />
      </customHeaders>
    </httpProtocol>

    <rewrite>
      <allowedServerVariables>
        <add name="HTTP_SEC_WEBSOCKET_EXTENSIONS" />
        <add name="HTTP_SEC_WEBSOCKET_VERSION" />
        <add name="HTTP_SEC_WEBSOCKET_KEY" />
      </allowedServerVariables>

      <rules>
        <rule name="CORS OPTIONS" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{REQUEST_METHOD}" pattern="^OPTIONS$" />
          </conditions>
          <action type="CustomResponse" statusCode="204" statusReason="Preflight" statusDescription="Preflight" />
          <serverVariables>
            <set name="HTTP_ACCESS_CONTROL_ALLOW_ORIGIN" value="https://devtaskflow.sheenlac.com" />
            <set name="HTTP_ACCESS_CONTROL_ALLOW_METHODS" value="GET, POST, PUT, DELETE, OPTIONS, PATCH" />
            <set name="HTTP_ACCESS_CONTROL_ALLOW_HEADERS" value="Content-Type, Authorization, X-Requested-With, Accept, Origin" />
            <set name="HTTP_ACCESS_CONTROL_ALLOW_CREDENTIALS" value="true" />
            <set name="HTTP_ACCESS_CONTROL_MAX_AGE" value="86400" />
          </serverVariables>
        </rule>

        <rule name="ReverseProxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
          <serverVariables>
            <set name="HTTP_SEC_WEBSOCKET_EXTENSIONS" value="" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
