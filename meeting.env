# ─────────────────────────────────────────────────────────────
#  Meeting media server (mediasoup SFU) settings
#  Loaded automatically at startup. Anything in .env overrides this file.
# ─────────────────────────────────────────────────────────────

# PUBLIC IP of the server that browsers connect to for audio/video.
#  - Local / LAN testing: leave commented -> the PC's LAN IP is detected automatically.
#  - Production (meet.sheenlac.com): set the server's public IP, e.g. 203.0.113.10
# MEDIASOUP_ANNOUNCED_IP=

# Address the media sockets bind to
MEDIASOUP_LISTEN_IP=0.0.0.0

# First media port. Each CPU core (worker) uses one port for UDP + TCP:
# 40000, 40001, ... -> open this range in Windows Firewall / cloud security group.
MEDIASOUP_PORT=40000

# How many CPU cores to use for media (default: all cores)
# MEDIASOUP_NUM_WORKERS=4

# Participants per core before a meeting spreads to the next core
MEDIASOUP_MAX_PEERS_PER_ROUTER=40

# Max participants in one meeting
MEETING_MAX_PARTICIPANTS=300

# mediasoup log level: debug | warn | error | none
MEDIASOUP_LOG_LEVEL=warn

# Optional TURN relay for very strict networks (only allow port 443)
# TURN_HOST=turn.example.com
# TURN_USER=
# TURN_PASSWORD=
# TURN_TLS_PORT=443
